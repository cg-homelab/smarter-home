{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo sqlx prepare:*)",
      "Bash(make:*)",
      "Bash(sqlx migrate:*)",
      "Bash(bun install)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx --bun shadcn@latest add:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose logs:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(bash ./workflow-helpers/clippy-helper.sh)"
    ],
    "deny": ["Read(./.env)", "Edit(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting edited file"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sqlx-prepare-reminder.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/api-docs-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
